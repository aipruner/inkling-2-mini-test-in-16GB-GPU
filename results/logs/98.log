= Math.min(t - last, 100);\n  last = t;\n  if (state === 'playing') {\n    const interval = softDrop ? 45 : dropInterval();\n    acc += dt;\n    let guard = 0;\n    while (acc >= interval && state === 'playing' && guard++ < 10) {\n      acc -= interval;\n      if (!tryStepDown()) acc = 0; // lock occurred\n    }\n    if (state!=='playing') acc = 0;\n  }\n  draw();\n}\n```\n\nHmm tryStepDown returns true if moved. After lock (returns false), spawnPiece may set state gameover. Guard increments max 10 per frame to avoid infinite loop (can't lock repeatedly anyway).\n\ntryStepDown:\n\n```js\nfunction tryStepDown() {\n  if (!collides(current.matrix, px, py + 1)) { py++; return true; }\n  lockPiece();\n  return false;\n}\n```\n\nlockPiece calls spawnPiece which may trigger gameOver and set state. Then tryStepDown returns false; loop sees state !== playing → acc=0. Good.\n\nhardDrop:\n\n```js\nfunction hardDrop() {\n  if (!current) return;\n  let d = 0;\n  while (!collides(current.matrix, px, py + 1)) { py++; d++; }\n  if (d > 0) { score += d * 2; }\n  lockPiece();\n}\n```\n\nclearLines returns count; score etc inside lockPiece:\n\n```js\nfunction lockPiece() {\n  const m = current.matrix;\n  for (let y = 0; y < m.length; y++)\n    for (let x = 0; x < m[y].length; x++)\n      if (m[y][x]) grid[py + y][px + x] = current.type;\n  // clear\n  let count = 0;\n  for (let y = ROWS - 1; y >= 0; y--) {\n    if (grid[y].every(v => v !== null)) {\n      grid.splice(y, 1);\n      grid.unshift(Array(ROWS ? COLS : COLS).fill(null));\n      count++;\n      y++;\n    }\n  }\n```\n\nCareful: grid.unshift row after splice; loop y should recheck same y: since after splice, the row above moves down into y; after unshift at top, the range shifts by 1 (rows count stays 20). Setting y++ then y-- via loop's y-- net — let's trace: outer loop y goes downward. When row y removed and replaced by unshifting blank at top, the row that was at y-1 now sits at y. We want to recheck y. After processing, r