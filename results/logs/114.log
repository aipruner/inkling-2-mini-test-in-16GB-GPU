ScoreEl = document.getElementById('final-score');\n\nlet grid, current, next, score, lines, gameOver, running, dropTimer, dropInterval, lastTime, softDrop;\n\nfunction emptyGrid() { return Array.from({length: ROWS}, () => Array(COLS).fill(null)); }\n\nfunction randomPiece() {\n  const keys = Object.keys(SHAPES);\n  const type = keys[Math.floor(Math.random() * keys.length)];\n  return { type, shape: SHAPES[type].map(r => r.slice()), x: Math.floor((COLS - SHAPES[type][0].length) / 2), y: 0 };\n}\n\nfunction collides(shape, px, py) {\n  for (let r = 0; r < shape.length; r++)\n    for (let c = 0; c < shape[r].length; c++) {\n      if (!shape[r][c]) continue;\n      const x = px + c, y = py + r;\n      if (x < 0 || x >= COLS || y >= ROWS) return true;\n      if (y >= 0 && grid[y][x]) return true;\n    }\n  return false;\n}\n\nfunction mergePiece() {\n  for (let r = 0; r < current.shape.length; r++)\n    for (let c = 0; c < current.shape[r].length; c++)\n      if (current.shape[r][c]) {\n        const y = current.y + r, x = current.x + c;\n        if (y >= 0) grid[y][x] = current.type;\n      }\n}\n\nfunction clearLines() {\n  let cleared = 0;\n  for (let r = ROWS - 1; r >= 0; r--) {\n    if (grid[r].every(cell => cell)) {\n      grid.splice(r, 1);\n      grid.unshift(Array(COLS).fill(null));\n      cleared++;\n      r++;\n    }\n  }\n  if (cleared) {\n    lines += cleared;\n    score += [0, 100, 300, 500, 800][cleared] || cleared * 400;\n    linesEl.textContent = lines;\n    scoreEl.textContent = score;\n    dropInterval = Math.max(80, 600 - lines * 20);\n  }\n}\n\nfunction spawn() {\n  current = next || randomPiece();\n  next = randomPiece();\n  current.x = Math.floor((COLS - current.shape[0].length) / 2);\n  current.y = current.type === 'I' ? -1 : 0;\n  if (collides(current.shape, current.x, current.y)) {\n    gameOver = true;\n    running = false;\n    finalScoreEl.textContent = score;\n    overlay.classList.add('show');\n  }\n  drawNext();\n}\n\nfunction rotate(dir) {\n  const m = current.shape;\n  const n = m.length;\n  const rotated = Array.from({length: n}, () => Array(n).fill(0));\n  for (let r = 0; r < n; r++)\n    for (let c = 0; c < n; c++)\n      rotated[c][n - 1 - r] = m[r][c];\n  for (const dx of [0, -1, 1, -2, 2]) {\n    if (!collides(rotated, current.x + dx, current.y)) {\n      current.shape = rotated;\n      current.x += dx;\n      return;\n    }\n  }\n}\n\nfunction move(dx, dy) {\n  if (!collides(current.shape, current.x + dx, current.y + dy)) {\n    current.x += dx; current.y += dy;\n    return true;\n  }\n  return false;\n}\n\nfunction hardDrop() {\n  let dist = 0;\n  while (move(0, 1)) dist++;\n  score += dist * 2;\n  scoreEl.textContent = score;\n  lockPiece();\n}\n\nfunction lockPiece() {\n  mergePiece();\n  clearLines();\n  spawn();\n}\n\nfunction drawCell(c, x, y, size) {\n  c.fillStyle = COLORS[x];\n  c.fillRect(y * size + 1, 0, 0, 0); // placeholder no-op (kept clean below)\n}\n\nfunction drawBoard() {\n  ctx.clearRect(0, 0, boardCanvas.width, boardCanvas.height);\n  // grid lines\n  ctx.strokeStyle = '#23233a';\n  ctx.lineWidth = 1;\n  for (let i = 0; i <= COLS; i++) { ctx.beginPath(); ctx.moveTo(i*CELL, 0); ctx.lineTo(i*CELL, ROWS*CELL); ctx.stroke(); }\n  for (let i = 0; i <= ROWS; i++) { ctx.beginPath(); ctx.moveTo(0, i*CELL); ctx.lineTo(COLS*CELL, i*CELL); ctx.stroke(); }\n  // locked\n  for (let r = 0; r < ROWS; r++)\n    for (let c = 0; c < COLS; c++)\n      if (grid[r][c]) drawCellAt(ctx, grid[r][c], c, r, CELL);\n  // current\n  if (current && !gameOver)\n    for (let r = 0; r < current.shape.length; r++)\n      for (let c = 0; c < current.shape[r].length; c++)\n        if (current.shape[r][c]) {\n          const y = current.y + r, x = current.x + c;\n          if (y >= 0) drawCellAt(ctx, current.type, x, y, CELL);\n        }\n}\n\nfunction drawCellAt(c, type, x, y, size) {\n  c.fillStyle = COLORS[type];\n  c.fillRect(x*size + 1, y*size + 1, size - 2, size - 2);\n  c.fillStyle = 'rgba(255,255,25