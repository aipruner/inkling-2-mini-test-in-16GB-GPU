const m = SHAPES[type].map(r=>[...r]);\n  return { type, matrix: m, x: Math.floor((COLS - m.length)/2), y: type==='I' ? -1 : 0 };\n}\n```\n\nHmm, I at y=-1: cells occupy row 1 of matrix → board rows 0. Let me keep y=0 for simplicity; I's cells at board row 1. Game over detection slightly different but fine. Actually spawning I at y=0 means nothing occupies row 0, slightly odd but fine. Keep y=0.\n\nWait — for rotation collision with by>=0 only; y=-1 would put cells... all by>=0 anyway? I at y=0: cells rows 1..1 (matrix row 1 = cells). Fine.\n\ngameOver:\n\n```js\nfunction gameOver() {\n  state = 'over';\n  highScore = Math.max(highScore, score);\n  localStorage.setItem('tetris-high', highScore);\n  show overlay with score\n  sounds\n}\n```\n\nstartGame:\n\n```js\nfunction startGame() {\n  board = matrix zeros;\n  score=0; lines=0; level=1;\n  state='playing'; paused=false; softDropping=false;\n  nextType = randomType();\n  spawnNext();  // sets piece + pulls new nextType, state playing\n  hide overlays;\n  updateHUD();\n}\n```\n\nNote spawnNext plays spawn position; maybe small \"lock\" sound? skip.\n\nKeyboard Start: Enter/Space in idle/over → startGame. Also click button.\n\nDrawing active piece with glow: ctx.shadowColor = color, shadowBlur = 12.\n\nNext preview: draw cells in a 4x4 area centered. Compute bounding box of matrix cells to center it.\n\n```js\nfunction updateNextPreview() {\n  const ctx = nextCtx; ctx.clearRect(...);\n  const m = SHAPES[nextType];\n  // find bbox\n  let minX=4,minY=4,maxX=0,maxY=0;\n  for y,x: if m[y][x] {minX=min(minX,x)...}\n  const w = maxX-minX+1, h=maxY-minY+1;\n  const cell = 24;\n  const ox = (4*cell - w*cell)/2 - minX*cell + ... hmm\n```\n\nSimpler: canvas 4x4 cells of 22px = 88x88. Center: ox = (4*cell - w*cell)/2; for each cell: px = (x-minX+ox)/cell... let me write:\n\n```js\nconst cell=22, size=4;\nconst ox = (size - w)/2, oy = (size - h)/2;\nfor y,x where m[y][x]: drawCell(ctx, ox+(x-minX), oy+(y-minY), cell, nextType);\n```\n\nFor O piece 2x2: ox=1, oy=1, nice centering. Good. drawCell uses global ctx param — write drawCell(ctx, px, py, s, type) where px,py are pixel coords? Let me make drawCell(ctx, cx, cy, s, type, opts) with pixel coords.\n\nBoard drawing loop draws filled cells using drawCell(boardCtx, x*CELL, y*CELL, CELL, type).\n\nGhost drawing: drawCell with alpha 0.25 and no gloss? Just stroke.\n\nOK writing final code. Also add subtle animated background and floating particles? Keep tasteful: radial gradients + maybe slow floating shapes via CSS. I'll add a few blurred orbs with CSS animation.\n\nControls legend panel lists: ← → 移動, ↑ 旋轉, ↓ 加速落下, 空白 立即落底, P 暫停, Enter 開始/重新開始.\n\nAudio:\n\n```js\nlet audioCtx = null;\nlet muted = localStorage.getItem('tetris-muted')==='1';\nfunction beep(freq, dur, type, vol, delay=0) {\n  if (muted) return;\n  try {\n    audioCtx = audioCtx || new (window.AudioContext||window.webkitAudioContext)();\n    if (audioCtx.state==='suspended') audioCtx.resume();\n    const t = audioCtx.currentTime + delay;\n    const o = audioCtx.createOscillator(), g = audioCtx.createGain();\n    o.type=type; o.frequency.setValueAtTime(freq, t);\n    g.gain.setValueAtTime(vol, t);\n    g.gain.exponentialRampToValueAtTime(0.0001, t+dur);\n    o.connect(g); g.connect(audioCtx.destination);\n    o.start(t); o.stop(t+dur);\n  } catch(e){}\n}\nsounds:\nmove: beep(180,0.05,'triangle',0.04)\nrotate: beep(260,0.06,'triangle',0.05)\nlock: beep(140,0.08,'square',0.05)\nclear: beep(523,0.1); beep(659,0.1,delay .08); beep(784,0.14,delay .16)\nhard: beep(90,0.12,'sawtooth',0.07)\ngameover: beep(330.. descending): 3 tones descending\nstart: ascending\n```\n\nMute button toggles and updates icon 🔊/🔇.\n\nNow write CSS. Use flex layout, gap. Panels width ~180px. Board frame with padding and border glow. Overlays absolute with backdrop blur.\n\nEnsure responsive: on narrow screens, stack panels below board via media query (max-width 900px) — maybe hide side panels? Keep them but reorder: use flex-wrap. Board should remain centered. I'll do: .game-shell {display:flex; gap:20px; justify-content:center; align-items:flex-start; flex-wrap:wrap;} with media query making side panels full width horizontal rows.\n\nSimpler: media query max-width 820px → shell column direction, side panels order after board with horizontal stat grids. Fine.\n\nOverlay pointer-events: when hidden, display:none.\n\nLet me write out everything now carefully.\n\nHTML skeleton with zh-Hant text.\n\nCSS details:\n\n```css\n* { box-sizing: border-box; margin:0; padding:0; }\nbody {\n  min-height: 100vh;\n  background: #070b16;\n  color: #e8ecf8;\n  font-family: \"PingFang TC\",\"Microsoft JhengHei\",system-ui,sans-serif;\n  overflow-x: hidden;\n  display:flex; flex-direction:column; align-items:center;\n}\n.orb { position: fixed; border-radius:50%; filter: blur(80px); opacity:.35; z-index:0; pointer-events:none; animation: float 12s ease-in-out infinite alternate; }\n```\n\nHeader with title gradient text.\n\nBoard frame:\n\n```css\n.board-wrap { position:relative; padding:10px; border-radius:18px; background: linear-gradient(160deg,#141b31,#0c1122); border:1px solid rgba(120,140,255,.25); box-shadow: 0 0 40px rgba(80,100,255,.18), inset 0 0 30px rgba(0,0,0,.5); }\ncanvas#board { display:block; border-radius:10px; }\n```\n\nCanvas internal: 300x600 (CELL=30).\n\nSide panels:\n\n```css\n.panel { display:flex; flex-direction:column; gap:14px; width:190px; }\n.stat-box { background: rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.09); border-radius:14px; padding:14px; backdrop-filter: blur(6px); text-align:center; }\n.stat-box span { font-size:12px; letter-spacing:2px; color:#93a0c4; }\n.stat-box strong { display:block; margin-top:6px; font-size:26px; font-variant-numeric: tabular-nums; color:#fff; text-shadow:0 0 12px rgba(140,160,255,.5); }\n```\n\nControls list with kbd styling.\n\nButtons: gradient purple-cyan, hover glow, active scale.\n\nOverlay:\n\n```css\n.overlay { position:absolute; inset:10px; border-radius:10px; background: rgba(7,11,22,.82); backdrop-filter: blur(8px); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:18px; text-align:center; z-index:5; }\n.overlay.hidden { display:none; }\n```\n\nButtons inside overlay with pointer events.\n\nGame over overlay similar with red-tinted glow.\n\nNow JavaScript full:\n\n```js\nconst COLS = 10, ROWS = 20, CELL = 30;\nconst SHAPES = {...};\nconst COLORS = {...};\nconst TYPES = ['I','O','T','S','Z','J','L'];\n\nlet board, piece, nextType, score, highScore, level, lines, state, paused, softDropping, clearingRows, clearTimer, dropAcc, last, dpr;\n\nconst boardCanvas = document.getElementById('board');\nconst boardCtx = boardCanvas.getContext('2d');\nconst nextCanvas = document.getElementById('nextCanvas');\nconst nextCtx = nextCanvas.getContext('2d');\n\nfunction initCanvases() {\n  dpr = window.devicePixelRatio || 1;\n  boardCanvas.width = COLS*CELL*dpr; boardCanvas.height = ROWS*CELL*dpr;\n  boardCanvas.style.width = COLS*CELL+'px'; boardCanvas.style.height = ROWS*CELL+'px';\n  boardCtx.setTransform(dpr,0,0,dpr,0,0);\n  const nc = 96; nextCanvas.width = nc*dpr; nextCanvas.height = nc*dpr;\n  nextCanvas.style.width = nc+'px'; nextCanvas.style.height = nc+'px';\n  nextCtx.setTransform(dpr,0,0,dpr,0,0);\n}\n```\n\nWait — when canvas.width set, transform resets; we set transform after. Good. On window resize, doesn't matter.\n\nrandomType: `TYPES[Math.floor(Math.random()*7)]`. Maybe use 7-bag randomizer for fairness — nice touch, simple:\n\n```js\nlet bag=[];\nfunction randomType() {\n  if (!bag.length) bag = [...TYPES].sort(()=>Math.random()-0.5);\n  return bag.pop();\n}\n```\n\nSort with random is fine for a bag.\n\ncollide as above.\n\ndraw():\n\n```js\nfunction draw() {\n  // bg\n  boardCtx.clearRect(0,0,COLS*CELL,ROWS*CELL);\n  boardCtx.fillStyle = '#0b1022';\n  boardCtx.fillRect(0,0,COLS*CELL,ROWS*CELL);\n  // grid\n  boardCtx.strokeStyle = 'rgba(255,255,255,0.045)';\n  boardCtx.lineWidth = 1;\n  for (let x=1;x<COLS;x++){ line } for y...\n  // static cells\n  for (let y=0;y<ROWS;y++) for (let x=0;x<COLS;x++)\n    if (board && board[y][x]) drawCell(boardCtx, x*CELL, y*CELL, CELL, board[y][x]);\n  // ghost\n  if (state==='playing' && !paused && piece) {\n    const gy = ghostRow();\n    if (gy !== piece.y) drawPieceCells(gy, ghost style)\n  }\n  // piece\n  if (piece && (state==='playing'||state==='clearing'||paused)) draw piece\n  // clearing flash overlay\n  if (state==='clearing' && clearingRows) {\n    const a = 0.35 + 0.45*Math.abs(Math.sin(clearTimer*0.06));\n    boardCtx.fillStyle = `rgba(255,255,255,${a})`;\n    clearingRows.forEach(y=> boardCtx.fillRect(0, y*CELL, COLS*CELL, CELL));\n  }\n}\n```\n\nNote: during clearing, piece should not be drawn (it locks into cells). I place piece cells into board before clearing starts, so the board shows them. Don't draw piece during clearing. So draw piece only when state==='playing' (and paused? also draw when paused). And when state==='over', board remains with stack; piece remains — draw piece? At game over, piece collided at spawn; drawing the stacked colors fine... piece might overlap. Better: on gameOver, set piece=null (keep stack board). Ghost: no piece → skip. But piece=null at spawn-collision means the offending piece isn't drawn — fine, stack shows. Good.\n\ndrawCell with per-type colors:\n\n```js\nfunction drawCell(ctx, px, py, s, type, alpha=1) {\n  const c = COLORS[type];\n  ctx.save();\n  ctx.globalAlpha = alpha;\n  const g = ctx.createLinearGradient(px, py, px, py+s);\n  g.addColorStop(0, c[0]); g.addColorStop(1, c[1]);\n  ctx.fillStyle = g;\n  roundRectPath(ctx, px+2, py+2, s-4, s-4, 5);\n  ctx.fill();\n  ctx.fillStyle = 'rgba(255,255,255,0.35)';\n  roundRectPath(ctx, px+5, py+5, s-10, (s-10)*0.38, 3);\n  ctx.fill();\n  ctx.strokeStyle = 'rgba(0,0,0,0.4)';\n  ctx.lineWidth = 1.5;\n  roundRectPath(ctx, px+1.5, py+1.5, s-3, s-3, 6);\n  ctx.stroke();\n  ctx.restore();\n}\n```\n\nGhost cells:\n\n```js\nfunction drawGhostCell(ctx, px, py, s, type) {\n  ctx.save();\n  ctx.strokeStyle = COLOR_HEX[type]-ish; ctx.globalAlpha=0.5; dashed border; fill low alpha;\n}\n```\n\nGhost with rounded rect + dashed stroke using the piece's color.\n\nRoundRect helper:\n\n```js\nfunction roundRectPath(ctx, x, y, w, h, r) {\n  ctx.beginPath();\n  ctx.moveTo(x+r, y);\n  ctx.arcTo(x+w, y, x+w, y+h, r);\n  ctx.arcTo(x+w, y+h, x, y+h, r);\n  ctx.arcTo(x, y+h, x, y, r);\n  ctx.arcTo(x, y, x+w, y, r);\n  ctx.closePath();\n}\n```\n\nNext preview draw:\n\n```js\nfunction drawNext() {\n  nextCtx.clearRect(0,0,96,96);\n  if (!nextType) return;\n  const m = SHAPES[nextType];\n  let minX=9,minY=9,maxX=-1,maxY=-1;\n  m.forEach((row,y)=>row.forEach((v,x)=>{ if(v){minX=Math.min(minX,x);maxX=Math.max(maxX,x);minY=Math.min(minY,y);maxY=Math.max(maxY,y);} }));\n  const w=maxX-minX+1,h=maxY-minY+1;\n  const size=96, cell=20; // 4*20=80\n  const ox=(size-w*cell)/2 - minX*cell;\n  const oy=(size-h*cell)/2 - minY*cell;\n  m.forEach((row,y)=>row.forEach((v,x)=>{ if(v) drawCell(nextCtx, ox+x*cell, oy+y*cell, cell, nextType); }));\n}\n```\n\nupdateNextPreview calls drawNext.\n\nHUD:\n\n```js\nfunction updateHUD() {\n  scoreEl.textContent = score;\n  highEl.textContent = highScore;\n  levelEl.textContent = level;\n  linesEl.textContent = lines;\n}\n```\n\ngameOver overlay content update: finalScore, record badge if score===highScore && score>0 && beat previous? Track oldHigh before update. In gameOver: const isRecord = score > highScore; highScore=Math.max(...); show record badge conditionally.\n\nNew game button binding.\n\nKeydown handling:\n\n```js\nwindow.addEventListener('keydown', e => {\n  const k = e.key;\n  if (['ArrowLeft','ArrowRight','ArrowUp','ArrowDown',' '].includes(k)) e.preventDefault();\n  if (k==='Enter' || (k===' ' && state!=='playing')) { if (state!=='playing') { startGame(); return; } }\n```\n\nCareful: in idle/over, space starts. In playing, space = hard drop. So:\n\n```js\n  if (state==='idle' || state==='over') {\n    if (k==='Enter' || k===' ') { startGame(); }\n    return;\n  }\n  if (k==='p' || k==='P' || k==='Escape') { togglePause(); return; }\n  if (paused) return;\n  if (state!=='playing') return;\n  switch (k) {\n    case 'ArrowLeft': if (!collide(piece.matrix, piece.x-1, piece.y)) { piece.x--; beep move } break;\n    case 'ArrowRight': similar;\n    case 'ArrowUp': if (!e.repeat) rotatePiece(1); else if allowed... \n```\n\nRotation with repeat: ignore repeat entirely (e.repeat → return), to avoid over-rotation. Actually many games allow; ignore is safer for accidental spins. Use: if (!e.repeat) rotatePiece(1).\n\n    case 'ArrowDown': softDropping = true; immediate step if not collide downward. break;\n    case ' ': if (!e.repeat) hardDrop(); break;\n  }\n});\n\nkeyup:\n\n```js\nwindow.addEventListener('keyup', e => { if (e.key==='ArrowDown') softDropping = false; });\n```\n\nNote: state playing but softDropping while clearing? step happens in loop only in playing. If clearing while soft hold, flag remains true; after clear fins, piece spawns and gravity accelerates — that's actually fine/expected (\"hold down to drop\").\n\nAlso blur event: clear softDropping and pause automatically when window loses focus — nice touch:\n\n```js\nwindow.addEventListener('blur', () => { softDropping=false; if (state==='playing' && !paused) togglePause(); });\n```\n\nNow the loop. Also initial state: 'idle' with board empty drawn and start overlay visible. Draw should handle board=null (before start): draw empty grid. Set board = empty grid at init, state='idle'.\n\nPause toggle:\n\n```js\nfunction togglePause() {\n  if (state!=='playing' && !paused) ... \n```\n\nSimplify: \n\n```js\nfunction togglePause() {\n  if (state!=='playing') return;\n  paused = !paused;\n  pauseOverlay.classList.toggle('hidden', !paused);\n}\n```\n\npauseOverlay: absolute overlay \"暫停中\" + hint.\n\nGame over ov