ineTo(x*CELL+0.5,canvas.height); }\n  for(let y=1;y<ROWS;y++){ ctx.moveTo(0,y*CELL+0.5); ctx.lineTo(canvas.width,y*CELL+0.5); }\n  ctx.stroke();\n  if(current){ for(let i=0;i<current.matrix.length;i++)for(let j=0;j<current.matrix[i].length;j++){ if(current.matrix[i][j]){ const bx=current.x+j, by=current.y+i; if(by>=0) drawCell(ctx,bx,by,CELL,current.color); } } }\n  drawNext();\n}\n```\n\ndrawCell:\n```js\nfunction drawCell(c,x,y,size,color){\n  const px=x*size, py=y*size;\n  c.fillStyle=color; c.fillRect(px+1,py+1,size-2,size-2);\n  c.fillStyle='rgba(255,255,255,0.35)'; c.fillRect(px+3,py+3,size-6,4);\n  c.fillStyle='rgba(0,0,0,0.28)'; c.fillRect(px+3,py+size-7,size-6,4);\n  c.strokeStyle='rgba(0,0,0,0.45)'; c.lineWidth=1; c.strokeRect(px+0.5,py+0.5,size-1,size-1);\n}\n```\n\ndrawNext:\n```js\nfunction drawNext(){\n  nctx.clearRect(0,0,nextCanvas.width,nextCanvas.height);\n  nctx.fillStyle='#11142c'; nctx.fillRect(0,0,nextCanvas.width,nextCanvas.height);\n  if(!nextType) return;\n  const s=SHAPES[nextType]; const n=s.m.length; const size=Math.floor(nextCanvas.width/Math.max(4,n));\n  const ox=(nextCanvas.width - n*size)/2, oy=(nextCanvas.height - n*size)/2;\n  nctx.save(); nctx.translate(ox,oy);\n  for(let i=0;i<n;i++)for(let j=0;j<n;j++){ if(s.m[i][j]) drawCell(nctx,j,i,size,s.c); }\n  nctx.restore();\n}\n```\nsize = floor(120/4)=30 fits 4x4=120. Good. For 2x2 O: size=30, n=2 → occupies 60x60 centered. fine.\n\nhardDrop:\n```js\nfunction hardDrop(){\n  if(state!=='playing'||!current) return;\n  let dist=0;\n  while(!collide(current.matrix,current.x,current.y+1)){ current.y++; dist++; }\n  score+=2*dist; updateUI(); lockPiece();\n}\n```\n\nrotate:\n```js\nfunction rotate(dir){\n  if(state!=='playing'||!current) return;\n  const rotated=rotateMatrix(current.matrix,dir);\n  const kicks=[[0,0],[-1,0],[1,0],[0,-1],[-2,0],[2,0],[0,1]];\n  for(let k=0;k<kicks.length;k++){\n    const dx=kicks[k][0], dy=kicks[k][1];\n    if(!collide(rotated,current.x+dx,current.y+dy)){\n      current.matrix=rotated; current.x+=dx; current.y+=dy; return;\n    }\n  }\n}\n```\n\nEvents:\n```js\ndocument.addEventListener('keydown',function(e){\n  if(['ArrowLeft','ArrowRight','ArrowDown','ArrowUp','Space'].indexOf(e.code)!==-1) e.preventDefault();\n  if(e.repeat) {} // allow repeat\n  if(e.code==='Enter'){\n    if(state==='ready'||state==='over') startGame();\n    else if(state==='paused') togglePause();\n    return;\n  }\n  if(e.code==='KeyP'){ togglePause(); return; }\n  if(state!=='playing') return;\n  switch(e.code){\n    case 'ArrowLeft': move(-1,0); break;\n    case 'ArrowRight': move(1,0); break;\n    case 'ArrowDown': move(0,1); break;\n    case 'ArrowUp': case 'KeyX': rotate(1); break;\n    case 'KeyZ': rotate(-1); break;\n    case 'Space': hardDrop(); break;\n  }\n});\n```\nWait togglePause with state ready/over: togglePause does nothing for those states. For paused, toggles. Enter handling already. Also 'KeyP' when ready—togglePause no-op. fine.\n\nButtons:\n```js\nconst startBtn=document.getElementById('startBtn');\nconst pauseBtn=document.getElementById('pauseBtn');\nconst overlay=document.getElementById('overlay');\nconst overlayTitle=document.getElementById('overlayTitle');\nconst overlayText=document.getElementById('overlayText');\nconst overlayBtn=document.getElementById('overlayBtn');\n\nstartBtn.addEventListener('click',function(){ this.blur(); if(state==='paused'){ togglePause(); } else { startGame(); } });\n```\n`this` in regular function with arrow? use function(){} and this.blur(). OK.\n\npauseBtn:\n```js\npauseBtn.addEventListener('click',function(){ this.blur(); if(state==='playing'||state==='paused') togglePause(); });\n```\n\noverlayBtn:\n```js\noverlayBtn.addEventListener('click',function(){\n  this.blur();\n  if(state==='paused') togglePause();\n  else startGame();\n});\n```\n\nTouch buttons: select `.tbtn[data-act]`:\n```js\ndocument.querySelectorAll('.tbtn').forEach(function(btn){\n  btn.addEventListener('click',function(){\